{
  "name": "velocity-luxury",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "images": "tsx scripts/generate-images.ts",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "apply:media": "tsx scripts/apply-photos.ts",
    "vercel-build": "prisma generate && prisma db push --skip-generate && tsx prisma/seed-if-empty.ts && next build",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/model-viewer": "^4.4.0",
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "next": "15.5.29",
    "nodemailer": "^10.5.0",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}